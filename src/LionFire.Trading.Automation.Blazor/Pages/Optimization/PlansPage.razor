    // New plan dialog methods

    private void OnNewPlanBotChanged(string newBot)
    {
        _newPlanBot = newBot;
        if (_duplicateSourcePlan == null)
        {
            _newPlanName = $"{newBot} Optimization";
        }
        _newPlanUserEditedId = false;
        AutoGenerateNewPlanId();
    }

    private void OnNewPlanIdManualEdit(string newId)
    {
        _newPlanId = newId;
        _newPlanUserEditedId = true;
    }

    private void AutoGenerateNewPlanId()
    {
        if (_newPlanUserEditedId) return;

        var prefix = _newPlanBot.ToLowerInvariant();
        if (string.IsNullOrEmpty(prefix)) prefix = "plan";

        var pattern = new Regex($@"^{Regex.Escape(prefix)}-(\d+)$");
        int maxN = 0;
        foreach (var plan in _plans)
        {
            var match = pattern.Match(plan.Id);
            if (match.Success && int.TryParse(match.Groups[1].Value, out var n))
            {
                maxN = Math.Max(maxN, n);
            }
        }

        _newPlanId = $"{prefix}-{maxN + 1}";
    }

    private bool IsNewPlanFormValid()
    {
        return !string.IsNullOrWhiteSpace(_newPlanBot)
            && !string.IsNullOrWhiteSpace(_newPlanName)
            && !string.IsNullOrWhiteSpace(_newPlanId);
    }

    private async Task CreateNewPlan()
    {
        if (!IsNewPlanFormValid()) return;

        // Check if ID already exists
        if (_plans.Any(p => p.Id == _newPlanId))
        {
            Snackbar.Add($"Plan '{_newPlanId}' already exists", Severity.Error);
            return;
        }

        OptimizationPlan newPlan;
        if (_duplicateSourcePlan != null)
        {
            // Duplicate from source
            newPlan = _duplicateSourcePlan with
            {
                Id = _newPlanId,
                Name = _newPlanName,
                Bot = _newPlanBot,
                Version = 1,
                Created = DateTime.UtcNow
            };
        }
        else
        {
            // Brand new plan with defaults
            newPlan = new OptimizationPlan
            {
                Id = _newPlanId,
                Name = _newPlanName,
                Bot = _newPlanBot,
                Symbols = new OptimizationPlanSymbols
                {
                    Type = "static",
                    Snapshot = ["BTCUSDT", "ETHUSDT"]
                },
                Timeframes = ["m5", "m15", "h1"],
                DateRanges =
                [
                    new OptimizationDateRange { Name = "1mo", Start = "-1M", End = "now" },
                    new OptimizationDateRange { Name = "3mo", Start = "-3M", End = "now" }
                ],
                Resolution = new OptimizationResolution
                {
                    MaxBacktests = 1000,
                    MinParameterPriority = 0
                },
                Tags = [],
                Version = 1,
                Created = DateTime.UtcNow
            };
        }

        try
        {
            var savedPlan = await Repository.SaveAsync(newPlan);
            _plans.Add(savedPlan);

            // Update bot counts
            var bot = NormalizeBotName(savedPlan.Bot);
            if (!_planBots.Contains(bot)) _planBots.Add(bot);
            _planCounts[bot] = _plans.Count(p => NormalizeBotName(p.Bot) == bot);

            _newPlanDialogVisible = false;
            Snackbar.Add($"Created plan '{savedPlan.Name}'", Severity.Success);

            // Select and navigate to the new plan
            _selectedPlan = savedPlan;
            _selectedBot = bot;
            _activeDetailTab = 0;
            await LoadCurrentExecutionState();
            Navigation.NavigateTo($"/optimization/plans/{savedPlan.Id}");
        }
        catch (PlanValidationException ex)
        {
            foreach (var error in ex.Errors)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create: {ex.Message}", Severity.Error);
        }
    }

    private static string NormalizeBotName(string botName)
    {
        if (string.IsNullOrEmpty(botName)) return botName;
        return botName.StartsWith("P") && botName.Length > 1 && char.IsUpper(botName[1])
            ? botName[1..]
            : botName;
    }

    public void Dispose()
    {
        _pollTimer?.Stop();
        _pollTimer?.Dispose();
    }
