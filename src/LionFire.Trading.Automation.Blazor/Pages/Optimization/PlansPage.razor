@page "/optimization/plans"
@page "/optimization/plans/{PlanId}"
@page "/optimization/plans/{PlanId}/{DetailView}"
@namespace LionFire.Trading.Automation.Blazor.Pages.Optimization
@using LionFire.Trading.Optimization.Plans
@using LionFire.Trading.Optimization.Execution
@using LionFire.Trading.Automation.Blazor.Components.Optimization
@using LionFire.Trading.Automation.Blazor.Optimization.Matrix
@using LionFire.TypeRegistration
@using LionFire.Trading.Grains.User
@using LionFire.Trading.Optimization.Matrix
@using Orleans
@using System.Text.RegularExpressions

<PageTitle>@_pageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 plans-page">
    <div class="page-header mb-4">
        @if (!_isGridView)
        {
            @if (!_masterPanelVisible && !_masterPanelTemporarilyShown && _selectedPlan != null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               OnClick="ShowMasterPanelAndDeselect"
                               Size="Size.Medium"
                               Title="Back to plan list"
                               Class="mr-1" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               OnClick="ToggleMasterPanel"
                               Size="Size.Medium"
                               Title="@(_isMasterPanelEffectivelyVisible ? "Hide navigation panel" : "Show navigation panel")"
                               Class="mr-1" />
            }
        }
        <MudText Typo="Typo.h4">@_pageTitle</MudText>

        @if (!_isGridView && _selectedPlan != null)
        {
            <MudButtonGroup OverrideStyles="false" Class="ml-4">
                <MudTooltip Text="@($"Run {_unfinishedCellCount} unfinished cell{(_unfinishedCellCount == 1 ? "" : "s")}")">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                   Size="Size.Small"
                                   Disabled="@(_unfinishedCellCount == 0)"
                                   OnClick="RunUnfinishedCells" />
                </MudTooltip>
                <MudTooltip Text="Re-run all cells">
                    <MudIconButton Icon="@Icons.Material.Filled.Replay"
                                   Size="Size.Small"
                                   OnClick="RerunAllCells" />
                </MudTooltip>
                <MudTooltip Text="@($"Next {_nextDepthBacktestCount} backtests")">
                    <MudIconButton Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                   Size="Size.Small"
                                   Disabled="true" />
                </MudTooltip>
                <MudTooltip Text="Complete search">
                    <MudIconButton Icon="@Icons.Material.Filled.VerticalAlignBottom"
                                   Size="Size.Small"
                                   Disabled="true" />
                </MudTooltip>
            </MudButtonGroup>

            @if (_progressTotalJobs > 0)
            {
                <div class="d-flex align-center gap-2 ml-4">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @_progressCompletedJobs/@_progressTotalJobs jobs
                    </MudText>
                    @if (_progressCompletedCells > 0)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                            ✓ @_progressCompletedCells
                        </MudChip>
                    }
                    @if (_progressRunningCells > 0)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">
                            ▶ @_progressRunningCells
                        </MudChip>
                    }
                    @if (_progressQueuedCells > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            ⏳ @_progressQueuedCells
                        </MudChip>
                    }
                    @if (_progressFailedCells > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                            ✗ @_progressFailedCells
                        </MudChip>
                    }
                </div>
            }
        }

        <MudSpacer />

        <MudToggleIconButton @bind-Toggled="_isGridView"
                             Icon="@Icons.Material.Filled.ViewList"
                             ToggledIcon="@Icons.Material.Filled.GridView"
                             Title="@(_isGridView ? "Switch to List View" : "Switch to Grid View")"
                             Size="Size.Medium" />
    </div>

    @if (_isGridView)
    {
        @* Grid View *@
        <MudPaper Class="pa-4">
            <div class="filter-bar">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search plans..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="search-field" />

                <MudSelect T="string" @bind-Value="_selectedBot"
                           Label="Bot Type" Clearable="true" Class="filter-select">
                    @foreach (var bot in _botTypes)
                    {
                        <MudSelectItem Value="@bot">@bot</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_selectedTag"
                           Label="Tag" Clearable="true" Class="filter-select">
                    @foreach (var tag in _allTags)
                    {
                        <MudSelectItem Value="@tag">@tag</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_sortBy" Label="Sort By" Class="filter-select">
                    <MudSelectItem Value="@("name")">Name</MudSelectItem>
                    <MudSelectItem Value="@("modified")">Last Modified</MudSelectItem>
                    <MudSelectItem Value="@("created")">Created</MudSelectItem>
                </MudSelect>
            </div>
        </MudPaper>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-4" />
        }
        else if (_filteredPlans.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                @if (_plans.Count == 0)
                {
                    <span>No optimization plans yet. <MudLink OnClick="OpenNewPlanDialog" Style="cursor: pointer;">Create your first plan</MudLink>.</span>
                }
                else
                {
                    <span>No plans match your filters.</span>
                }
            </MudAlert>
        }
        else
        {
            <div class="plans-grid mt-4">
                @foreach (var plan in _filteredPlans)
                {
                    <OptimizationPlanCard Plan="@plan"
                                          OnEdit="EditPlan"
                                          OnDuplicate="DuplicatePlan"
                                          OnDelete="ConfirmDeletePlan" />
                }
            </div>
        }
    }
    else
    {
        @* Master-Detail View *@
        <div class="master-detail-layout">
            @* Left Panel: Bot List + Plan List *@
            <div class="left-panel" style="@(_isMasterPanelEffectivelyVisible ? "" : "display: none")">
                <MudPaper Class="@($"bot-list-container {(string.IsNullOrEmpty(_selectedBot) ? "expanded" : "")}")" Elevation="1">
                    <BotListNav @bind-SelectedBot="_selectedBot"
                                RegisteredBots="_registeredBots"
                                PlanBots="_planBots"
                                PlanCounts="_planCounts"
                                OnBotChanged="OnBotFilterChanged"
                                OnNewPlan="OpenNewPlanDialog" />
                </MudPaper>

                @if (!string.IsNullOrEmpty(_selectedBot))
                {
                    <MudPaper Class="plan-list-container" Elevation="1">
                        <PlanListNav BotFilter="_selectedBot"
                                     SelectedPlanId="@PlanId"
                                     Plans="_filteredPlans"
                                     ExecutionStates="_executionStates"
                                     OnPlanSelected="OnPlanSelected" />
                    </MudPaper>
                }
            </div>

            @* Right Panel: Detail View *@
            <div class="right-panel">
                @if (_selectedPlan != null)
                {
                    @* Detail View Tabs *@
                    <MudPaper Elevation="1">
                        <MudTabs ActivePanelIndex="_activeDetailTab" ActivePanelIndexChanged="OnActiveTabChanged"
                                 ApplyEffectsToContainer="true" PanelClass="pa-4">
                            <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Info">
                                <PlanOverviewTab Plan="_selectedPlan"
                                                 OnDuplicate="@(() => DuplicatePlan(_selectedPlan))"
                                                 OnDelete="@(() => ConfirmDeletePlan(_selectedPlan))"
                                                 OnPlanChanged="OnPlanChanged" />
                            </MudTabPanel>

                            <MudTabPanel Text="Symbols" Icon="@Icons.Material.Filled.Checklist">
                                <PlanSymbolsTab Plan="_selectedPlan" OnSave="SavePlanSettings" />
                            </MudTabPanel>

                            <MudTabPanel Text="Date Ranges" Icon="@Icons.Material.Filled.DateRange">
                                <PlanDateRangesTab Plan="_selectedPlan" OnSave="SavePlanSettings" />
                            </MudTabPanel>

                            <MudTabPanel Text="Parameters" Icon="@Icons.Material.Filled.Tune">
                                <PlanParametersTab Plan="_selectedPlan" BotTypeRegistry="BotTypeRegistry" OnSave="OnPlanChanged" />
                            </MudTabPanel>

                            <MudTabPanel Text="Matrix" Icon="@Icons.Material.Filled.GridOn">
                                <OptimizationMatrixDashboard Plan="_selectedPlan" PlanId="@_selectedPlan.Id"
                                                             OnRunCell="RunCell"
                                                             OnCellDrillDown="HandleMatrixCellDrillDown"
                                                             OnOpenCellInOneShot="OpenCellInOneShot"
                                                             OnNavigateToSymbolsTab="GoToSymbolsTab"
                                                             OnPlanChanged="OnPlanChanged" />
                            </MudTabPanel>

                            <MudTabPanel Text="Performance" Icon="@Icons.Material.Filled.Speed">
                                <PlanPerformanceTab Plan="_selectedPlan"
                                                    ExecutionState="_currentExecutionState"
                                                    OnStartExecution="StartExecution"
                                                    OnStopExecution="StopExecution"
                                                    OnPauseExecution="PauseExecution"
                                                    OnResumeExecution="ResumeExecution"
                                                    OnPlanChanged="OnPlanChanged" />
                            </MudTabPanel>

                            <MudTabPanel Text="Jobs" Icon="@Icons.Material.Filled.List">
                                <PlanJobsTab ExecutionState="_currentExecutionState"
                                             OnRetryFailed="RetryFailedJobs" />
                            </MudTabPanel>

                            <MudTabPanel Text="Results" Icon="@Icons.Material.Filled.Assessment">
                                <PlanResultsTab ExecutionState="_currentExecutionState" />
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="pa-8 text-center placeholder" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large"
                                 Class="mud-text-secondary mb-4" />
                        <MudText Typo="Typo.h6" Class="mud-text-secondary">
                            Select a plan to view details
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            Choose a plan from the list on the left, or
                            <MudLink OnClick="OpenNewPlanDialog" Style="cursor: pointer;">create a new plan</MudLink>.
                        </MudText>
                    </MudPaper>
                }
            </div>
        </div>
    }
</MudContainer>

<MudDialog @bind-Visible="_deleteDialogVisible">
    <TitleContent>Delete Plan</TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete "<strong>@_planToDelete?.Name</strong>"?</MudText>
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
            This action cannot be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _deleteDialogVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="DeletePlan">Delete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_newPlanDialogVisible" Options="_newPlanDialogOptions">
    <TitleContent>@(_duplicateSourcePlan != null ? "Duplicate Plan" : "New Optimization Plan")</TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="string" Value="_newPlanBot" ValueChanged="OnNewPlanBotChanged"
                           Label="Bot Type" Variant="Variant.Outlined"
                           HelperText="Select the bot to optimize">
                    @foreach (var bot in _registeredBots)
                    {
                        <MudSelectItem Value="@bot">@bot</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newPlanName" Label="Name"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Value="_newPlanId" ValueChanged="OnNewPlanIdManualEdit"
                              Label="Plan ID" Variant="Variant.Outlined"
                              HelperText="@(_newPlanUserEditedId ? "Custom ID" : "Auto-generated from bot type")" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _newPlanDialogVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="CreateNewPlan"
                   Disabled="@(!IsNewPlanFormValid())">
            @(_duplicateSourcePlan != null ? "Duplicate" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .plans-page {
        height: calc(100vh - 64px - 32px);
        display: flex;
        flex-direction: column;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .filter-bar {
        display: flex;
        gap: 16px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .search-field {
        min-width: 250px;
        flex: 1;
    }

    .filter-select {
        min-width: 150px;
    }

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 16px;
    }

    .master-detail-layout {
        display: flex;
        gap: 16px;
        flex: 1;
        min-height: 0;
    }

    .left-panel {
        width: 280px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
    }

    .bot-list-container {
        overflow-y: auto;
    }

    .bot-list-container.expanded {
        flex: 1;
        min-height: 0;
    }

    .plan-list-container {
        flex: 1;
        overflow-y: auto;
        min-height: 0;
    }

    .right-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .right-panel > .mud-paper {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .placeholder {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    @@media (max-width: 900px) {
        .master-detail-layout {
            flex-direction: column;
        }

        .left-panel {
            width: 100%;
            max-height: 300px;
        }

        .right-panel {
            flex: 1;
        }
    }
</style>

@code {
    [Parameter] public string? PlanId { get; set; }
    [Parameter] public string? DetailView { get; set; }

    private List<OptimizationPlan> _plans = [];
    private bool _loading = true;
    private string _searchText = "";
    private string? _selectedBot;
    private string? _selectedTag;
    private string _sortBy = "modified";
    private bool _deleteDialogVisible;
    private OptimizationPlan? _planToDelete;

    // New plan dialog state
    private bool _newPlanDialogVisible;
    private string _newPlanBot = "";
    private string _newPlanName = "";
    private string _newPlanId = "";
    private bool _newPlanUserEditedId;
    private OptimizationPlan? _duplicateSourcePlan;
    private static readonly DialogOptions _newPlanDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool _isGridView = false; // Default to master-detail
    private int _activeDetailTab = 0;
    private bool _masterPanelVisible = true;
    private bool _masterPanelTemporarilyShown; // Transient: revealed via back arrow for plan picking
    private int _nextDepthBacktestCount = 0; // TODO: compute from plan depth search config

    private IReadOnlyList<string> _botTypes = [];
    private IReadOnlyList<string> _allTags = [];
    private List<string> _registeredBots = [];
    private List<string> _planBots = [];
    private Dictionary<string, int> _planCounts = new();
    private OptimizationPlan? _selectedPlan;
    private Dictionary<string, PlanExecutionState> _executionStates = new();
    private PlanExecutionState? _currentExecutionState;
    private System.Timers.Timer? _pollTimer;

    [Inject] private IOptimizationPlanRepository Repository { get; set; } = default!;
    [Inject] private IPlanExecutionService ExecutionService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private BotTypeRegistry? BotTypeRegistry { get; set; }
    [Inject] private IClusterClient? ClusterClient { get; set; }
    [Inject] private IMatrixResultsProvider ResultsProvider { get; set; } = default!;

    private const string MasterPanelVisibleKey = "plans-page:master-panel-visible";
    private const string LastDetailTabKey = "plans-page:last-detail-tab";
    private const string LastPlanIdKey = "plans-page:last-plan-id";

    private bool _isMasterPanelEffectivelyVisible => _masterPanelVisible || _masterPanelTemporarilyShown || (_selectedPlan == null && !_isGridView);

    private void OpenNewPlanDialog()
    {
        _duplicateSourcePlan = null;
        _newPlanBot = !string.IsNullOrEmpty(_selectedBot) ? _selectedBot
            : _registeredBots.FirstOrDefault() ?? "";
        _newPlanName = !string.IsNullOrEmpty(_newPlanBot) ? $"{_newPlanBot} Optimization" : "";
        _newPlanUserEditedId = false;
        AutoGenerateNewPlanId();
        _newPlanDialogVisible = true;
    }

    private string _pageTitle => _selectedPlan != null
        ? _selectedPlan.Name
        : !string.IsNullOrEmpty(_selectedBot)
            ? $"Optimization Plans for {_selectedBot}"
            : "Optimization Plans";

    private int _totalCellCount => _selectedPlan == null ? 0
        : _selectedPlan.Symbols.EffectiveSymbols.Count()
          * _selectedPlan.Timeframes.Count
          * Math.Max(1, _selectedPlan.DateRanges.Count);

    private int _unfinishedCellCount => _totalCellCount - _progressCompletedCells;

    private Dictionary<string, MatrixCellProgress> _cellProgress = new();
    private int _progressCompletedCells => _cellProgress.Values.Count(p => p.VisualState == CellVisualState.Complete);
    private int _progressRunningCells => _cellProgress.Values.Count(p => p.VisualState == CellVisualState.Running);
    private int _progressQueuedCells => _cellProgress.Values.Count(p => p.VisualState == CellVisualState.Queued);
    private int _progressFailedCells => _cellProgress.Values.Count(p => p.VisualState == CellVisualState.Failed);
    private int _progressTotalJobs => _cellProgress.Values.Sum(p => p.TotalJobs);
    private int _progressCompletedJobs => _cellProgress.Values.Sum(p => p.CompletedJobs);

    private List<OptimizationPlan> _filteredPlans => _plans
        .Where(p => string.IsNullOrWhiteSpace(_searchText) ||
                    p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(p => string.IsNullOrWhiteSpace(_selectedBot) || NormalizeBotName(p.Bot) == _selectedBot)
        .Where(p => string.IsNullOrWhiteSpace(_selectedTag) || p.Tags.Contains(_selectedTag))
        .OrderBy(p => _sortBy switch
        {
            "name" => (object)p.Name,
            "modified" => p.Modified,
            "created" => p.Created,
            _ => p.Modified
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadMasterPanelPreference();
        await LoadPlans();
        await LoadExecutionStates();

        if (!string.IsNullOrEmpty(PlanId))
        {
            _selectedPlan = _plans.FirstOrDefault(p => p.Id == PlanId);
            _selectedBot = _selectedPlan?.Bot is string bot ? NormalizeBotName(bot) : null;
            await LoadCurrentExecutionState();
        }

        StartPolling();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PlanId != _selectedPlan?.Id)
        {
            _selectedPlan = !string.IsNullOrEmpty(PlanId)
                ? _plans.FirstOrDefault(p => p.Id == PlanId)
                : null;
            _selectedBot = _selectedPlan?.Bot is string bot ? NormalizeBotName(bot) : null;
            await LoadCurrentExecutionState();
        }

        // Map DetailView route parameter to tab index
        if (!string.IsNullOrEmpty(DetailView))
        {
            _activeDetailTab = DetailView.ToLowerInvariant() switch
            {
                "overview" => 0,
                "symbols" => 1,
                "date-ranges" => 2,
                "parameters" => 3,
                "matrix" => 4,
                "performance" => 5,
                "jobs" => 6,
                "results" => 7,
                _ => _activeDetailTab
            };
        }
        else if (_selectedPlan != null)
        {
            await RestoreLastDetailTab();
        }

        StateHasChanged();
    }

    private async Task LoadPlans()
    {
        _loading = true;
        _plans = (await Repository.ListAsync()).ToList();
        _botTypes = _plans.Select(p => NormalizeBotName(p.Bot)).Distinct().OrderBy(b => b).ToList();
        _allTags = _plans.SelectMany(p => p.Tags).Distinct().OrderBy(t => t).ToList();

        // Get registered bot types from the type registry
        _registeredBots = BotTypeRegistry?.PBotRegistry.Names.Keys
            .Select(NormalizeBotName)
            .Distinct()
            .OrderBy(b => b)
            .ToList() ?? [];

        _planBots = _plans
            .Select(p => p.Bot)
            .Where(b => !string.IsNullOrEmpty(b))
            .Select(NormalizeBotName)
            .Distinct()
            .ToList();
        _planCounts = _plans
            .Where(p => !string.IsNullOrEmpty(p.Bot))
            .GroupBy(p => NormalizeBotName(p.Bot))
            .ToDictionary(g => g.Key, g => g.Count());

        _loading = false;
    }

    private async Task LoadExecutionStates()
    {
        var activeStates = await ExecutionService.GetAllActiveAsync();
        _executionStates = activeStates.ToDictionary(s => s.PlanId);
    }

    private async Task LoadCurrentExecutionState()
    {
        if (_selectedPlan != null)
        {
            _currentExecutionState = await ExecutionService.GetStatusAsync(_selectedPlan.Id);
            _cellProgress = await ResultsProvider.GetProgressAsync(_selectedPlan.Id);
        }
        else
        {
            _currentExecutionState = null;
            _cellProgress = new();
        }
    }

    private void OnBotFilterChanged(string? bot)
    {
        _selectedBot = bot;
        if (_selectedPlan != null && !_filteredPlans.Contains(_selectedPlan))
        {
            _selectedPlan = null;
            _currentExecutionState = null;
            Navigation.NavigateTo("/optimization/plans");
        }
    }

    private async Task OnPlanSelected(string planId)
    {
        _selectedPlan = _plans.FirstOrDefault(p => p.Id == planId);
        _masterPanelTemporarilyShown = false; // Auto-hide if it was temporarily revealed
        await LoadCurrentExecutionState();
        Navigation.NavigateTo($"/optimization/plans/{planId}");
    }

    private void EditPlan(OptimizationPlan plan)
    {
        // Select the plan and navigate to its settings tab
        _selectedPlan = plan;
        _selectedBot = NormalizeBotName(plan.Bot);
        _activeDetailTab = 0; // Overview tab
        _masterPanelTemporarilyShown = false;
        Navigation.NavigateTo($"/optimization/plans/{plan.Id}");
    }

    private void OnPlanChanged(OptimizationPlan updatedPlan)
    {
        var index = _plans.FindIndex(p => p.Id == updatedPlan.Id);
        if (index >= 0) _plans[index] = updatedPlan;
        _selectedPlan = updatedPlan;
    }

    private async Task SavePlanSettings(OptimizationPlan updatedPlan)
    {
        try
        {
            var savedPlan = await Repository.SaveAsync(updatedPlan);

            // Update local state
            var index = _plans.FindIndex(p => p.Id == savedPlan.Id);
            if (index >= 0)
            {
                _plans[index] = savedPlan;
            }
            _selectedPlan = savedPlan;

            Snackbar.Add($"Plan '{savedPlan.Name}' saved (version {savedPlan.Version})", Severity.Success);
        }
        catch (PlanValidationException ex)
        {
            Snackbar.Add($"Validation failed: {string.Join(", ", ex.Errors)}", Severity.Error);
            throw; // Re-throw so the settings tab knows save failed
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save: {ex.Message}", Severity.Error);
            throw; // Re-throw so the settings tab knows save failed
        }
    }

    private void DuplicatePlan(OptimizationPlan plan)
    {
        _duplicateSourcePlan = plan;
        _newPlanBot = NormalizeBotName(plan.Bot);
        _newPlanName = $"{plan.Name} (copy)";
        _newPlanUserEditedId = false;
        AutoGenerateNewPlanId();
        _newPlanDialogVisible = true;
    }

    private void ConfirmDeletePlan(OptimizationPlan plan)
    {
        _planToDelete = plan;
        _deleteDialogVisible = true;
    }

    private async Task DeletePlan()
    {
        if (_planToDelete != null)
        {
            await Repository.DeleteAsync(_planToDelete.Id);
            _plans.Remove(_planToDelete);
            if (_selectedPlan?.Id == _planToDelete.Id)
            {
                _selectedPlan = null;
                _currentExecutionState = null;
                Navigation.NavigateTo("/optimization/plans");
            }
            Snackbar.Add($"Deleted plan '{_planToDelete.Name}'", Severity.Success);
            _planToDelete = null;
            _deleteDialogVisible = false;
        }
    }

    private async Task StartExecution((int workers, bool usePrioritization) args)
    {
        if (_selectedPlan == null) return;

        try
        {
            var options = new PlanExecutionOptions
            {
                ParallelWorkers = args.workers,
                UsePrioritization = args.usePrioritization
            };
            _currentExecutionState = await ExecutionService.StartAsync(_selectedPlan.Id, options);
