    private async Task RunCell((string Symbol, string Timeframe, string? DateRangeName) cell)
    {
        if (_selectedPlan == null) return;

        try
        {
            var options = new PlanExecutionOptions
            {
                ParallelWorkers = 1,
                UsePrioritization = false,
                DateRangeFilter = cell.DateRangeName
            };

            // Check for already-completed jobs and prompt before re-running
            var state = await ExecutionService.GetStatusAsync(_selectedPlan.Id);
            var completedCount = state?.Jobs?.Count(j =>
                j.Symbol == cell.Symbol && j.Timeframe == cell.Timeframe &&
                (cell.DateRangeName == null || j.DateRange.Name == cell.DateRangeName) &&
                j.Status == JobStatus.Completed) ?? 0;

            if (completedCount > 0)
            {
                var rangeLabel = cell.DateRangeName ?? "all ranges";
                var confirmed = await DialogService.ShowMessageBox(
                    "Cell Already Completed",
                    $"{cell.Symbol} / {cell.Timeframe} ({rangeLabel}) has {completedCount} completed job(s). Re-run?",
                    yesText: "Re-run", cancelText: "Cancel");
                if (confirmed != true) return;
                options = options with { SkipCompleted = false };
            }

            _currentExecutionState = await ExecutionService.RunCellAsync(
                _selectedPlan.Id,
                cell.Symbol,
                cell.Timeframe,
                options);

            if (_currentExecutionState != null)
            {
                _executionStates[_selectedPlan.Id] = _currentExecutionState;
            }

            var rangeInfo = !string.IsNullOrEmpty(cell.DateRangeName) ? $" ({cell.DateRangeName})" : "";
            Snackbar.Add($"Started optimization for {cell.Symbol} / {cell.Timeframe}{rangeInfo}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to start: {ex.Message}", Severity.Error);
        }
    }

    private void OpenCellInOneShot((string Symbol, string Timeframe) cell)
    {
        if (_selectedPlan == null) return;

        // Navigate to one-shot optimization page with parameters pre-filled
        var bot = NormalizeBotName(_selectedPlan.Bot);
        Navigation.NavigateTo(
            $"/optimize/one-shot?bot={Uri.EscapeDataString(bot)}&symbol={Uri.EscapeDataString(cell.Symbol)}&timeframe={Uri.EscapeDataString(cell.Timeframe)}");
    }

    private async Task HandleMatrixCellDrillDown(MatrixCellEventArgs args)
    {
        if (_selectedPlan == null) return;

        var state = await ExecutionService.GetStatusAsync(_selectedPlan.Id);

        if (args.DateRangeName != null)
        {
            // Specific date range selected -> navigate to PlanJobDetail for that job
            var job = state?.Jobs.FirstOrDefault(j =>
                j.Symbol == args.Symbol && j.Timeframe == args.Timeframe &&
                j.DateRange.Name == args.DateRangeName && j.Status == JobStatus.Completed);
            if (job != null)
            {
                Navigation.NavigateTo($"/optimization/plan/{Uri.EscapeDataString(_selectedPlan.Id)}/job/{Uri.EscapeDataString(job.Id)}");
            }
            else
            {
                // No execution state job found — navigate to cell results page which will try disk scan
                Navigation.NavigateTo($"/optimization/plan/{Uri.EscapeDataString(_selectedPlan.Id)}/cell/{Uri.EscapeDataString(args.Symbol)}/{Uri.EscapeDataString(args.Timeframe)}");
            }
        }
        else
        {
            // "All Ranges" selected -> navigate to cell results page listing all date-range jobs
            Navigation.NavigateTo($"/optimization/plan/{Uri.EscapeDataString(_selectedPlan.Id)}/cell/{Uri.EscapeDataString(args.Symbol)}/{Uri.EscapeDataString(args.Timeframe)}");
        }
    }

    private void StartPolling()
    {
        _pollTimer = new System.Timers.Timer(5000);
        _pollTimer.Elapsed += async (s, e) => await PollForUpdates();
        _pollTimer.Start();
    }

    private async Task PollForUpdates()
    {
        try
        {
            await LoadExecutionStates();
            await LoadCurrentExecutionState();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Ignore polling errors
        }
    }

    /// <summary>
    /// Normalize bot name by stripping the "P" prefix used in parameter types.
    /// E.g., "PAtrBot" -> "AtrBot"
    /// </summary>
    private static readonly string[] TabNames = ["overview", "symbols", "date-ranges", "parameters", "matrix", "performance", "jobs", "results"];

    private void OnActiveTabChanged(int index)
    {
        if (index == _activeDetailTab) return;
        _activeDetailTab = index;

        if (_selectedPlan != null)
        {
            var tabName = index >= 0 && index < TabNames.Length ? TabNames[index] : null;
            var url = tabName is "overview" or null
                ? $"/optimization/plans/{_selectedPlan.Id}"
                : $"/optimization/plans/{_selectedPlan.Id}/{tabName}";
            Navigation.NavigateTo(url, replace: true);
        }

        _ = SaveLastDetailTab(index);
    }

    private async Task SaveLastDetailTab(int index)
    {
        try
        {
            if (ClusterClient != null && index >= 0 && index < TabNames.Length)
            {
                var grain = ClusterClient.GetGrain<IUserPreferencesG>("Anonymous");
                await grain.SetViewSetting(LastDetailTabKey, TabNames[index]);
            }
        }
        catch { /* Best effort */ }
    }

    private void GoToSymbolsTab()
    {
        OnActiveTabChanged(1); // "symbols" is tab index 1
    }

    private async Task LoadMasterPanelPreference()
    {
        try
        {
            if (ClusterClient != null)
            {
                var grain = ClusterClient.GetGrain<IUserPreferencesG>("Anonymous");
                var value = await grain.GetViewSetting(MasterPanelVisibleKey);
                if (value != null)
                {
                    _masterPanelVisible = value != "false";
                }
            }
        }
