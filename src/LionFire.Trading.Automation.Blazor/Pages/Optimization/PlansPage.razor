    private async Task RestoreLastDetailTab()
    {
        try
        {
            if (ClusterClient != null)
            {
                var grain = ClusterClient.GetGrain<IUserPreferencesG>("Anonymous");
                var savedTab = await grain.GetViewSetting(LastDetailTabKey);
                if (savedTab != null)
                {
                    var index = Array.IndexOf(TabNames, savedTab);
                    if (index >= 0) _activeDetailTab = index;
                }
            }
        }
        catch { /* Use default */ }
    }

