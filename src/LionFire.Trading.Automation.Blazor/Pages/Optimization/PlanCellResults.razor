@page "/optimization/plan/{PlanId}/cell/{Symbol}/{Timeframe}"
@namespace LionFire.Trading.Automation.Blazor.Pages.Optimization
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using LionFire.Trading.Automation.Optimization.Matrix
@using LionFire.Trading.Optimization.Execution
@using LionFire.Trading.Optimization.Plans

@inject IPlanExecutionService ExecutionService
@inject IOptimizationPlanRepository PlanRepository
@inject DiskBacktestResultsScanner DiskScanner
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="d-flex flex-column flex-grow-1 gap-2">
    @* Header *@
    <MudPaper Class="pa-4">
        <div class="d-flex align-center gap-2 mb-2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="NavigateBack"
                           Title="Back to Plan" />
            <MudText Typo="Typo.h6">@Symbol / @Timeframe</MudText>
            <MudSpacer />
            @if (_planName != null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_planName</MudText>
            }
        </div>

        @* Summary stats *@
        @if (_displayItems.Count > 0)
        {
            <div class="d-flex flex-row gap-6 flex-wrap">
                <div class="lf-field">
                    <div class="label">Total Jobs</div>
                    <div class="value">@_displayItems.Count</div>
                </div>
                <div class="lf-field">
                    <div class="label">Completed</div>
                    <div class="value">@_completedCount</div>
                </div>
                @if (_bestAD.HasValue)
                {
                    <div class="lf-field">
                        <div class="label">Best AD</div>
                        <div class="value">@_bestAD.Value.ToString("F2")</div>
                    </div>
                }
                @if (_fromDisk)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="ml-2">From disk</MudChip>
                }
            </div>
        }
    </MudPaper>

    @* Jobs table *@
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_displayItems.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">
            No results found for @Symbol / @Timeframe in this plan.
        </MudAlert>
    }
    else
    {
        <MudPaper>
            <MudTable Items="@_displayItems" Dense="true" Hover="true" Striped="true"
                      OnRowClick="@OnRowClick" T="CellJobDisplayItem" RowClass="cursor-pointer">
                <HeaderContent>
                    <MudTh>Date Range</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Best AD</MudTh>
                    <MudTh>Backtests</MudTh>
                    <MudTh>Passing</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date Range">@context.DateRangeName</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@context.StatusColor" Size="Size.Small">@context.StatusText</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Best AD">@context.BestAD.ToString("F2")</MudTd>
                    <MudTd DataLabel="Backtests">@context.TotalBacktests.ToString("N0")</MudTd>
                    <MudTd DataLabel="Passing">@(context.PassingCount?.ToString("N0") ?? "-")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public string PlanId { get; set; } = "";
    [Parameter] public string Symbol { get; set; } = "";
    [Parameter] public string Timeframe { get; set; } = "";

    private List<CellJobDisplayItem> _displayItems = [];
    private bool _loading = true;
    private bool _fromDisk;
    private string? _planName;
    private int _completedCount;
    private double? _bestAD;

    protected override async Task OnInitializedAsync()
    {
        // Load plan name
        try
        {
            var plan = await PlanRepository.GetAsync(PlanId);
            _planName = plan?.Name;
        }
        catch { /* ignore */ }

        // Try execution state first
        var state = await ExecutionService.GetStatusAsync(PlanId);
        var jobs = state?.Jobs
            .Where(j => j.Symbol == Symbol && j.Timeframe == Timeframe)
            .OrderBy(j => j.StartDate)
            .ToList() ?? [];

        if (jobs.Count > 0)
        {
            _displayItems = jobs.Select(j => new CellJobDisplayItem
            {
                DateRangeName = !string.IsNullOrEmpty(j.DateRange.Name)
                    ? j.DateRange.Name
                    : $"{j.StartDate:yyyy-MM-dd} - {j.EndDate:yyyy-MM-dd}",
                StatusText = j.Status.ToString(),
                StatusColor = j.Status switch
                {
                    JobStatus.Completed => Color.Success,
                    JobStatus.Running => Color.Info,
                    JobStatus.Failed => Color.Error,
                    _ => Color.Default,
                },
                BestAD = j.BestAD ?? 0,
                TotalBacktests = j.TotalBacktests ?? 0,
                PassingCount = j.GoodBacktestCount,
                JobId = j.Id,
            }).ToList();
        }
        else
        {
            // Fallback: scan disk for results
            var diskResults = await DiskScanner.ScanCellDetailAsync(PlanId, Symbol, Timeframe);
            if (diskResults.Count > 0)
            {
                _fromDisk = true;
                _displayItems = diskResults
                    .OrderBy(d => d.DateRangeName)
                    .Select(d => new CellJobDisplayItem
                    {
                        DateRangeName = d.DateRangeName,
                        StatusText = "Completed",
                        StatusColor = Color.Success,
                        BestAD = d.BestAd,
                        TotalBacktests = d.TotalBacktests,
                        PassingCount = d.PassingCount,
                        ResultPath = d.ResultPath,
                    }).ToList();
            }
        }

        _completedCount = _displayItems.Count(d => d.StatusText == "Completed");
        var bestAd = _displayItems.Where(d => d.BestAD > 0).Select(d => d.BestAD).DefaultIfEmpty().Max();
        _bestAD = bestAd > 0 ? bestAd : null;

        _loading = false;
    }

    private void OnRowClick(TableRowClickEventArgs<CellJobDisplayItem> args)
    {
        var item = args.Item;
        if (item.JobId != null)
        {
            Navigation.NavigateTo($"/optimization/plan/{Uri.EscapeDataString(PlanId)}/job/{Uri.EscapeDataString(item.JobId)}");
        }
        else if (item.ResultPath != null)
        {
            Navigation.NavigateTo($"/optimization/plan/{Uri.EscapeDataString(PlanId)}/job/disk?resultPath={Uri.EscapeDataString(item.ResultPath)}");
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo($"/optimization/plans/{Uri.EscapeDataString(PlanId)}/matrix");
    }

    private record CellJobDisplayItem
    {
        public string DateRangeName { get; init; } = "";
        public string StatusText { get; init; } = "";
        public Color StatusColor { get; init; } = Color.Default;
        public double BestAD { get; init; }
        public int TotalBacktests { get; init; }
        public int? PassingCount { get; init; }
        public string? JobId { get; init; }
        public string? ResultPath { get; init; }
    }
}
