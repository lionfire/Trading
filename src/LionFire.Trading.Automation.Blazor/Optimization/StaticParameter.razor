@using LionFire.Trading.Automation.Optimization

<MudItem sm="2" Class="@((info.ParameterAttribute.OptimizePriorityInt >= POptimization.MinParameterPriority ? "Enabled border-solid mud-border-primary" : "Disabled border-dotted mud-border-secondary") + "  border-2 ")">
    <div class="d-flex flex-row justify-start align-start">

        <MudCheckBox @bind-Value=options.EnableOptimization />
        <MudTooltip Text="@info.Path">
            <MudText Typo=Typo.h6 class="ParameterName">
                @info.EffectiveName
            </MudText>
        </MudTooltip>
    </div>
    <div class="lf-field row">
        <div class="value"> @info.ParameterAttribute.OptimizePriorityInt </div>
        <label>Priority</label>
    </div>
</MudItem>


@code {

    [Parameter]
    public POptimization POptimization { get; set; } = default!;

    [Parameter]
    public (HierarchicalPropertyInfo info, IParameterOptimizationOptions options) Parameter { get; set; }

    #region Convenience

    public HierarchicalPropertyInfo info => Parameter.info;
    public IParameterOptimizationOptions options => Parameter.options;

    #endregion
}
