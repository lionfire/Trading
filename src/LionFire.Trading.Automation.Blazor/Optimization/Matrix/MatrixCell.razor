@using MudBlazor
@using LionFire.Trading.Optimization.Matrix
@using LionFire.Trading.Automation.Optimization.Matrix
@namespace LionFire.Trading.Automation.Blazor.Optimization.Matrix

<div class="matrix-cell @StateCssClass @(IsSelected ? "matrix-cell-selected" : "") @(IsFocused ? "matrix-cell-focused" : "") @(IsAutoUpdated ? "matrix-cell-auto-updated" : "") @(HasResults || IsEnabled ? "matrix-cell-grid" : "")"
     style="@CellInlineStyle"
     title="@TooltipText"
     @onclick="OnCellClick"
     @onclick:stopPropagation
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault
     @oncontextmenu:stopPropagation>
    @if (HasResults)
    {
        @* === Row 1: best-ad | bars (stacked) | stats === *@
        <span class="matrix-cell-best-ad" title="@($"Best AD: {Result!.BestAd:F2}")">@Result!.BestAd.ToString("F1")</span>
        <div class="matrix-cell-bars">
            <div class="matrix-cell-bar" style="@DistributionBarStyle" title="@DistributionBarTooltip"></div>
            <div class="matrix-cell-bar" style="@DistributionBarStyle" title="@DistributionBarTooltip"></div>
        </div>
        <span class="matrix-cell-backtest-stats" title="@($"{Result.PassingCount} passing / {TotalAll} total backtests")">@Result.PassingCount / @TotalAll</span>

        @* === Row 2: grab | score | abort === *@
        <div class="matrix-cell-grab-area">
            <span class="matrix-cell-grab-handle" @onclick="OnGrabClick" @onclick:stopPropagation title="Click to select cell (Ctrl+click for multi-select)">&#x2630;</span>
        </div>
        <div class="matrix-cell-score-area">
            @if (Result.Score.HasValue)
            {
                <span class="matrix-cell-score"
                      style="@($"font-size: {ScoreFontSize}rem;")"
                      title="@($"Score: {Result.Score.Value:F1} | Grade: {GradeText} - {GradeDescription}")">
                    @Result.Score.Value.ToString("F0")
                </span>
            }
            else
            {
                <span class="matrix-cell-score"
                      style="@($"font-size: {ScoreFontSize}rem;")"
                      title="@($"Grade: {GradeText} - {GradeDescription}")">
                    @GradeText
                </span>
            }
        </div>
        @if (Result.AbortedBacktests > 0)
        {
            <span class="matrix-cell-abort-pct" title="@($"{Result.AbortedBacktests} aborted ({AbortPercentText})")">@(AbortPercentText)</span>
        }

        @* === Row 3: grade | lod (placeholder) | avg-ad === *@
        <span class="matrix-cell-grade-label" title="@($"Grade: {GradeText} - {GradeDescription}")">@GradeText</span>
        <div class="matrix-cell-lod" title="@LodTooltip">
            @if (Result!.AchievedLevelOfDetail.HasValue)
            {
                <span class="matrix-cell-lod-text">L@(Result.AchievedLevelOfDetail) · @FormatSI(Result.BacktestsAtLevel ?? 0)</span>
                @if (IsEnabled)
                {
                    @if (CurrentLodAction == LodAction.Idle)
                    {
                        <button class="matrix-cell-lod-btn" @onclick="QueueNextLodLevel" @onclick:stopPropagation title="@LodActionTooltip">+@NextLevelCountText</button>
                    }
                    else if (CurrentLodAction == LodAction.Queued)
                    {
                        <span class="matrix-cell-lod-btn matrix-cell-lod-queued" title="@LodActionTooltip">...@NextLevelCountText</span>
                    }
                    else if (CurrentLodAction == LodAction.Running)
                    {
                        <button class="matrix-cell-lod-btn matrix-cell-lod-running" @onclick="CancelLodJob" @onclick:stopPropagation title="@LodActionTooltip">
                            <span class="lod-icon-play">&#x25B6;</span><span class="lod-icon-stop">&#x25A0;</span>@NextLevelCountText
                        </button>
                    }
                }
            }
        </div>
        <span class="matrix-cell-avg-ad" title="@($"Average AD: {Result.AverageAd:F2}")">@Result.AverageAd.ToString("F1")</span>

        @* Disabled overlay *@
        @if (!IsEnabled)
        {
            <div class="matrix-cell-disabled-overlay" title="Disabled — right-click to enable">
                <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
            </div>
        }
    }
    else if (VisualState == CellVisualState.NoHistory)
    {
        @* === No History: show muted indicator without priority === *@
        <div class="matrix-cell-no-history-content">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" Style="opacity: 0.5;" />
            <span class="matrix-cell-no-history-label">No Data</span>
        </div>
    }
    else if (IsEnabled)
    {
        @* === No Results: priority controls in grid === *@
        <div class="matrix-cell-grab-area">
            <span class="matrix-cell-grab-handle" @onclick="OnGrabClick" @onclick:stopPropagation title="Click to select cell (Ctrl+click for multi-select)">&#x2630;</span>
        </div>
        <div class="matrix-cell-score-area matrix-cell-priority-area">
            <button class="matrix-cell-priority-btn" @onclick="DecreasePriority" @onclick:stopPropagation title="Decrease priority">&minus;</button>
            <span class="matrix-cell-priority-display" style="@PriorityChipStyle">@EffectivePriority</span>
            <button class="matrix-cell-priority-btn" @onclick="IncreasePriority" @onclick:stopPropagation title="Increase priority">+</button>
        </div>

        <div class="matrix-cell-lod">
            @* Planned LoD — requires MaxBacktests + bot param space (future) *@
        </div>
    }
    else
    {
        @* Disabled with no results *@
        <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Class="mud-text-disabled" />
    }

    @if (IsEnabled)
    {
        @* Autopilot/manual badges (absolute positioned) *@
        @if (CellPriority is { IsAutopilot: true, AutoPriority: not null })
        {
            <span class="matrix-cell-autopilot-badge" title="Autopilot">A</span>
        }
        @if (CellPriority is { IsAutopilot: false })
        {
            <button class="matrix-cell-manual-indicator" @onclick="ResetToAutopilot" @onclick:stopPropagation title="Click to reset to auto mode">M</button>
        }

        @if (Progress is { TotalJobs: > 0 } && VisualState is CellVisualState.Running or CellVisualState.Queued)
        {
            <div class="matrix-cell-progress-bar @(VisualState == CellVisualState.Running ? "matrix-cell-progress-determinate" : "matrix-cell-progress-indeterminate")"
                 style="@(VisualState == CellVisualState.Running ? $"width: {ProgressPercent:F1}%;" : "")"
                 title="@ProgressBarTooltip">
            </div>
        }

        @if (Progress is { FailedJobs: > 0 })
        {
            <span class="matrix-cell-failure-badge" title="@Progress.FailedJobs job(s) failed">@Progress.FailedJobs</span>
        }
    }
</div>

@if (_contextMenuOpen)
{
    <MudOverlay Visible="true" OnClick="CloseContextMenu" LockScroll="false" />
    <MudPopover Open="true"
                AnchorOrigin="Origin.BottomLeft"
                TransformOrigin="Origin.TopLeft"
                Class="matrix-context-menu">
        <MudList T="string" Dense="true" Class="py-1" Style="min-width: 180px;">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Assessment" OnClick="ViewResults">
                View Results
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Replay" OnClick="ReRunOptimization">
                Re-run Optimization
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.OpenInNew" OnClick="ContextOpenInOneShot">
                Open in One-Shot
            </MudListItem>
            <MudDivider />
            <MudListItem T="string" Icon="@(IsEnabled ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" OnClick="ContextToggleEnabled">
                @(IsEnabled ? "Disable" : "Enable")
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ArrowUpward" OnClick="ContextIncreasePriority">
                Increase Priority
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ArrowDownward" OnClick="ContextDecreasePriority">
                Decrease Priority
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.RestartAlt" OnClick="ResetPriority">
                Reset Priority
            </MudListItem>
            <MudDivider />
            <MudListItem T="string" Icon="@Icons.Material.Filled.History" OnClick="ViewHistory">
                View History
            </MudListItem>
        </MudList>
    </MudPopover>
}

@code {
    private bool ShouldPreventDefault => false;
}

<style>
    .matrix-cell {
        background-color: var(--mud-palette-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 60px;
        min-height: 36px;
        position: relative;
        cursor: pointer;
        transition: background-color 0.3s ease, opacity 0.3s ease, border-color 0.3s ease;
        gap: 3px;
    }

    .matrix-cell:hover {
        filter: brightness(1.1);
    }

    /* Grid layout for cells with content (enabled or disabled-with-results) */
    .matrix-cell-grid {
        display: grid;
        grid-template-areas:
            "best-ad   bars      stats"
            "grab      score     abort"
            "grade     lod       avg-ad";
        grid-template-columns: auto 1fr auto;
        grid-template-rows: auto auto auto;
        align-items: center;
        padding: 1px 2px;
        gap: 0;
        min-height: 48px;
    }

    .matrix-cell-best-ad {
        grid-area: best-ad;
        font-size: 0.6rem;
        font-weight: 500;
        color: rgba(255,255,255,0.85);
        justify-self: start;
        line-height: 1.2;
    }

    .matrix-cell-bars {
        grid-area: bars;
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin: 0 3px;
        min-width: 10px;
    }

    .matrix-cell-bar {
        height: 2px;
        border-radius: 1px;
    }

    .matrix-cell-backtest-stats {
        grid-area: stats;
        font-size: 0.55rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        justify-self: end;
        line-height: 1.2;
        white-space: nowrap;
    }

    .matrix-cell-abort-pct {
        grid-area: abort;
        font-size: 0.5rem;
        color: #bbb;
        background-color: rgba(0,0,0,0.6);
        border-radius: 2px;
        padding: 0 2px;
        justify-self: end;
        line-height: 1.2;
    }

    .matrix-cell-grab-area {
        grid-area: grab;
        justify-self: start;
        display: flex;
        align-items: center;
    }

    .matrix-cell-grab-handle {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.2);
        cursor: grab;
        padding: 2px 3px;
        line-height: 1;
        border-radius: 2px;
        user-select: none;
        transition: color 150ms, background-color 150ms;
    }

    .matrix-cell:hover .matrix-cell-grab-handle {
        color: rgba(255,255,255,0.5);
    }

    .matrix-cell-grab-handle:hover {
        color: rgba(255,255,255,0.9) !important;
        background-color: rgba(255,255,255,0.1);
    }

    .matrix-cell-selected .matrix-cell-grab-handle {
        color: #1976D2;
    }

    .matrix-cell-score-area {
        grid-area: score;
        justify-self: center;
        display: flex;
        justify-content: center;
    }

    .matrix-cell-score {
        color: #fff;
        font-weight: 700;
        line-height: 20px;
    }

    .matrix-cell-grade-label {
        grid-area: grade;
        font-size: 0.55rem;
        font-weight: 600;
        color: rgba(255,255,255,0.7);
        justify-self: start;
        line-height: 1.2;
    }

    .matrix-cell-lod {
        grid-area: lod;
        font-size: 0.55rem;
        color: rgba(255,255,255,0.7);
        justify-self: center;
        line-height: 1.2;
        display: flex;
        align-items: center;
        gap: 2px;
        white-space: nowrap;
    }

    .matrix-cell-lod-text {
        white-space: nowrap;
    }

    .matrix-cell-lod-btn {
        display: inline-flex;
        align-items: center;
        padding: 0 2px;
        font-size: 0.5rem;
        font-weight: 500;
        color: rgba(255,255,255,0.8);
        background: none;
        border: 1px solid transparent;
        border-radius: 2px;
        cursor: pointer;
        white-space: nowrap;
        line-height: 1;
    }

    .matrix-cell-lod-btn:hover {
        color: rgba(255,255,255,1);
        border-color: rgba(255,255,255,0.3);
    }

    .matrix-cell-lod-queued {
        cursor: default;
        color: rgba(255,255,255,0.5);
    }

    .matrix-cell-lod-queued:hover {
        color: rgba(255,255,255,0.5);
        border-color: transparent;
    }

    .matrix-cell-lod-running .lod-icon-play { display: inline; }
    .matrix-cell-lod-running .lod-icon-stop { display: none; }
    .matrix-cell-lod-running:hover .lod-icon-play { display: none; }
    .matrix-cell-lod-running:hover .lod-icon-stop { display: inline; color: #F44336; }

    .matrix-cell-avg-ad {
        grid-area: avg-ad;
        font-size: 0.55rem;
        font-weight: 400;
        color: rgba(255,255,255,0.6);
        justify-self: end;
        line-height: 1.2;
    }

    /* === No-results priority display === */

    .matrix-cell-priority-area {
        gap: 6px;
        align-items: center;
    }

    .matrix-cell-priority-display {
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1;
    }

    .matrix-cell-priority-btn {
        padding: 0;
        margin: 0;
        width: 18px;
        height: 18px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 3px;
        background-color: var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 150ms ease-in-out;
    }

    .matrix-cell:hover .matrix-cell-priority-btn {
        opacity: 1;
    }

    .matrix-cell-priority-btn:hover {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        border-color: var(--mud-palette-primary);
    }

    /* === Cell visual states === */

    .matrix-cell-state-never-run {
        background-color: #444;
        color: #E0E0E0;
    }

    .matrix-cell-state-disabled {
        background-color: #9E9E9E;
        opacity: 0.5;
    }

    /* Disabled cell with results — dimmed grade background via inline style */
    .matrix-cell-state-disabled-with-results {
        opacity: 0.55;
        /* background-color set via inline style from CellColorEngine */
    }

    /* Overlay for disabled cells that have results — shows a subtle block icon */
    .matrix-cell-disabled-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 4;
    }

    .matrix-cell-disabled-overlay .mud-icon-root {
        opacity: 0.3;
        color: #fff;
        font-size: 1.2rem;
    }

    .matrix-cell-state-queued {
        background-color: #263238;
        border: 1px solid rgba(66,165,245,0.4);
    }

    .matrix-cell-state-running {
        background-color: #42A5F5;
        animation: matrix-pulse 1.5s ease-in-out infinite;
    }

    .matrix-cell-state-failed {
        border: 2px solid #FF9800;
    }

    .matrix-cell-state-no-history {
        background-color: #333;
        opacity: 0.6;
    }

    .matrix-cell-no-history-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 4px;
    }

    .matrix-cell-no-history-label {
        font-size: 0.55rem;
        color: rgba(255,255,255,0.4);
        white-space: nowrap;
    }

    .matrix-cell-state-complete {
        /* Background set via inline style from grade color */
    }

    @@keyframes matrix-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }

    /* === Absolute-positioned badges === */

    .matrix-cell-manual-indicator {
        position: absolute;
        top: 1px;
        right: 2px;
        font-size: 0.55rem;
        font-weight: 700;
        color: var(--mud-palette-warning);
        opacity: 0.7;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        line-height: 1;
    }

    .matrix-cell-manual-indicator:hover {
        opacity: 1;
        color: var(--mud-palette-warning-darken);
        text-decoration: underline;
    }

    .matrix-cell-autopilot-badge {
        position: absolute;
        top: 1px;
        left: 2px;
        font-size: 9px;
        color: #78909C;
        font-weight: 600;
        opacity: 0.7;
    }

    /* Brief highlight when auto-priority is updated */
    .matrix-cell-auto-updated {
        animation: matrix-auto-flash 2s ease-out;
    }

    @@keyframes matrix-auto-flash {
        0% { box-shadow: inset 0 0 0 2px #FFF176; }
        100% { box-shadow: inset 0 0 0 0 transparent; }
    }

    /* Progress bar at cell bottom edge */
    .matrix-cell-progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        z-index: 6;
    }

    .matrix-cell-progress-determinate {
        background-color: #42A5F5;
        transition: width 0.3s ease;
    }

    .matrix-cell-progress-indeterminate {
        right: 0;
        width: auto;
        background: linear-gradient(90deg, transparent 0%, #42A5F5 50%, transparent 100%);
        background-size: 200% 100%;
        animation: matrix-progress-slide 1.5s linear infinite;
    }

    @@keyframes matrix-progress-slide {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    /* Failure badge */
    .matrix-cell-failure-badge {
        position: absolute;
        top: 1px;
        right: 2px;
        font-size: 0.55rem;
        font-weight: 700;
        color: #fff;
        background-color: #F44336;
        border-radius: 3px;
        padding: 0 2px;
        line-height: 1.4;
        z-index: 5;
        pointer-events: none;
    }

    /* Selection highlight */
    .matrix-cell-selected {
        outline: 2px solid #1976D2;
        outline-offset: -2px;
        z-index: 1;
    }

    /* Keyboard focus indicator — hidden to reduce visual noise */
    .matrix-cell-focused {
    }

    /* Both selected and focused */
    .matrix-cell-selected.matrix-cell-focused {
        outline: 2px solid #1976D2;
        outline-offset: -2px;
    }

    /* Context menu styling */
    .matrix-context-menu {
        z-index: 10;
    }
</style>
